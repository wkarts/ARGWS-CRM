# Exemplo para compose.yaml usando banco externo. Copie para .env e ajuste os valores.
COMPOSE_PROJECT_NAME=argws-crm
ARGWS_VERSION=3.7.0
# Volumes persist under this path relative to the Compose file.
ARGWS_STORAGE_ROOT=./storage
ARGWS_HTTP_BIND=127.0.0.1
ARGWS_HTTP_PORT=8080
ARGWS_DB_HOST=CHANGE_ME_DATABASE_HOST
ARGWS_DB_NAME=argws_crm
ARGWS_DB_USER=argws_crm
ARGWS_DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Antes do primeiro acesso web, gere a chave com: openssl rand -hex 32
# Após provisionar, pode remover esta variável e recriar o serviço web.
ARGWS_SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

# Canais públicos de suporte (usados apenas quando configurados nas Definições).
# Número no formato país + DDD + telefone, sem +, espaços ou pontuação.
CRM_SUPPORT_WHATSAPP=
CRM_SUPPORT_EMAIL=
CRM_SUPPORT_SITE_URL=
# Slugs ocultos somente da listagem de Recursos; não desativa módulos.
CRM_HIDDEN_RESOURCES=
