COMPOSE_PROJECT_NAME=argws-crm-production
# All persistent data is mounted under this path relative to compose.yaml.
ARGWS_STORAGE_ROOT=./storage
ARGWS_CRM_IMAGE=ghcr.io/wkarts/argws-crm:4.1.5
ARGWS_CRM_DATABASE_IMAGE=ghcr.io/wkarts/argws-crm-mysql:8.0
ARGWS_HTTP_BIND=127.0.0.1
ARGWS_HTTP_PORT=8089
ARGWS_DB_HOST=database
MYSQL_DATABASE=argws_crm
MYSQL_USER=argws_crm
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
TZ=UTC

# Chave aleatória de uso único para autorizar o assistente web em /setup.
ARGWS_SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

# Canais públicos de suporte (usados apenas quando configurados nas Definições).
# Número no formato país + DDD + telefone, sem +, espaços ou pontuação.
CRM_SUPPORT_WHATSAPP=
CRM_SUPPORT_EMAIL=
CRM_SUPPORT_SITE_URL=
# Slugs ocultos somente da listagem de Recursos; não desativa módulos.
CRM_HIDDEN_RESOURCES=

# Disponibiliza o módulo iDEAL no catálogo, mantendo ativação e permissões administrativas.
CRM_ENABLE_IDEAL=false

# Nome exibido somente no instalador; não altera identidade da instalação ou emitentes.
INSTALLER_DISPLAY_NAME=ARGWS CRM
# Nome público do produto em execução. Vazio usa application/config/branding.php (padrão CRM).
APP_DISPLAY_NAME=
