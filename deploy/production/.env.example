COMPOSE_PROJECT_NAME=argws-crm-production
ARGWS_CRM_IMAGE=ghcr.io/wkarts/argws-crm:3.5.0
ARGWS_CRM_DATABASE_IMAGE=ghcr.io/wkarts/argws-crm-mysql:8.0
ARGWS_HTTP_BIND=127.0.0.1
ARGWS_HTTP_PORT=8089
ARGWS_DB_HOST=database
MYSQL_DATABASE=argws_crm
MYSQL_USER=argws_crm
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
TZ=UTC
